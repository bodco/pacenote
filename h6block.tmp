final class BodyFake: CRMTransport {
    var bodies: [[String: Any]] = []
    func send(_ method: String, _ path: String, _ body: [String: Any]?) async throws -> (Int, [String: Any], [String: String]) {
        bodies.append(body ?? [:]); return (200, ["id": "1", "portalId": 1], [:])
    }
}

/// H6: notes, deals and tasks for one Apply; a note or a task request can fail with a 500. Never the network.
final class ApplyFake: CRMTransport {
    var log: [String] = []
    var failNote = false, failTask = false
    func send(_ method: String, _ path: String, _ body: [String: Any]?) async throws -> (Int, [String: Any], [String: String]) {
        log.append(method + " " + path.split(separator: "?")[0])
        if path.hasPrefix("/crm/v3/objects/notes") && failNote { return (500, ["message": "HTTP 500"], [:]) }
        if path.hasPrefix("/crm/v3/objects/tasks") && failTask { return (500, ["message": "HTTP 500"], [:]) }
        return (200, ["id": "\(log.count)", "properties": [:]], [:])
    }
}

/// H6: answers a fixed status per path prefix (the scope probes). Never the network.
final class StatusFake: CRMTransport {
    var status: [String: Int] = [:]
    func send(_ method: String, _ path: String, _ body: [String: Any]?) async throws -> (Int, [String: Any], [String: String]) {
        let code = status.first { path.hasPrefix($0.key) }?.value ?? 200
        return (code, code == 403 ? ["message": "This app hasn't been granted all required scopes"] : [:], [:])
    }
}

/// H6 (PB-62): the sync settings API, field and owner mapping, the sync log, the live scope check. Mocked HubSpot only.
func crmSync() async {
    // settings: an old file has every Auto off; Calls read the H2 switch, the others their own
    let old = try? JSONDecoder().decode(CRMSettings.self, from: Data("{\"provider\":\"hubspot\",\"autoLogCall\":true}".utf8))
    expect(old?.autoWrites(.calls) == true && old?.sync == CRMSyncSettings(), "sync: an old settings file keeps the Call switch and has empty sync settings")
    var s = CRMSettings()
    expect(CRMObject.allCases.allSatisfy { !s.autoWrites($0) }, "sync: every Auto is off by default")
    s.writeCall = false; s.setAutoWrites(.calls, true)
    expect(s.autoLogCall && s.writeCall && s.autoWrites(.calls), "sync: Auto for Calls is the H2 switch and ticks the Call")
    s.setAutoWrites(.calls, false); s.setAutoWrites(.tasks, true)
    expect(!s.autoLogCall && s.autoWrites(.tasks) && !s.autoWrites(.deals), "sync: one switch per object")
    let back = try? JSONDecoder().decode(CRMSettings.self, from: JSONEncoder().encode(s))
    expect(back?.autoWrites(.tasks) == true && back?.autoWrites(.meetings) == false, "sync: switches survive a save")
    // field mapping: spec defaults, rename, Don't write; fixed properties never move
    expect(CRMObject.calls.defaultFields.map(\.property) == ["hs_call_title", "hs_call_body", "hs_call_duration", "hs_call_direction"]
           && CRMObject.deals.defaultFields.map(\.property) == ["hs_next_step", "closedate"] && CRMObject.tasks.defaultFields.map(\.property) == ["hs_task_subject"],
           "sync: field defaults are the spec's properties")
    s.sync.setProperty(.calls, "hs_call_title", to: "pn_call_title")
    s.sync.setProperty(.calls, "hs_call_body", to: "")
    s.sync.setProperty(.calls, "hs_call_external_id", to: "other")
    let m = s.mapped(.calls, ["hs_call_title": "t", "hs_call_body": "b", "hs_call_external_id": "pacenote:k", "hs_timestamp": "x"])
    expect(Set(m.keys) == ["pn_call_title", "hs_call_external_id", "hs_timestamp"], "sync: a mapped field is renamed, Don't write drops it, fixed ones stay")
    s.sync.setProperty(.calls, "hs_call_title", to: "hs_call_title")
    expect(s.property(.calls, "hs_call_title") == "hs_call_title" && s.sync.fields["calls"]?["hs_call_title"] == nil, "sync: back to the default removes the override")
    // the connector writes through the mapping: the Call and the task
    let t = FakeHubSpotCalls()
    let hs = HubSpotConnector(transport: t, sleep: { _ in })
    var sync = CRMSyncSettings(); sync.setProperty(.calls, "hs_call_title", to: "pn_call_title"); sync.setProperty(.calls, "hs_call_body", to: "")
    hs.sync = sync
    let entry = CRMCallLog(key: "k1", title: "Orbit renewal", start: Date(timeIntervalSince1970: 1_780_000_000), durationMs: 60_000,
                           body: CRMCallLog.body(summary: ["Budget approved"], nextSteps: [], participants: [], link: "", key: "k1"))
    let r1 = try? await hs.upsertCall(entry, knownId: "", associations: [])
    let c1 = t.calls[r1?.id ?? ""] ?? [:]
    expect(c1["pn_call_title"] == "Orbit renewal" && c1["hs_call_title"] == nil && c1["hs_call_body"] == nil && c1["hs_call_external_id"] == "pacenote:k1",
           "sync: the Call is written with the field mapping, the dedupe key unchanged")
    let r2 = try? await hs.upsertCall(entry, knownId: r1?.id ?? "", associations: [])
    expect(r2?.created == false && r2?.old["pn_call_title"] == "Orbit renewal", "sync: an update reads the mapped property for Undo")
    let bf = BodyFake()
    let hb = HubSpotConnector(transport: bf, sleep: { _ in })
    var ts = CRMSyncSettings(); ts.setProperty(.tasks, "hs_task_subject", to: "pn_subject"); hb.sync = ts
    _ = try? await hb.createTask(subject: "Send the demo link", due: nil, associations: [])
    let tp = (bf.bodies.last?["properties"] as? [String: Any]) ?? [:]
    expect(tp["pn_subject"] as? String == "Send the demo link" && tp["hs_task_subject"] == nil && tp["hs_task_status"] as? String == "NOT_STARTED", "sync: the task is written with the field mapping")
    var ds = CRMSyncSettings(); ds.setProperty(.deals, "hs_next_step", to: ""); hb.sync = ds
    let before = bf.bodies.count
    let none = try? await hb.updateDeal(id: "D1", fields: ["hs_next_step": "Call back"])
    expect(none == [:] && bf.bodies.count == before, "sync: a deal update with every field set to Don't write sends nothing")
    // reserved targets: a dedupe key, the owner, a status or another field's property is never a target
    var rs = CRMSyncSettings()
    rs.setProperty(.calls, "hs_call_title", to: "hs_call_external_id")
    rs.setProperty(.deals, "hs_next_step", to: "hubspot_owner_id")
    rs.setProperty(.calls, "hs_call_duration", to: "hs_call_body")
    expect(rs.fields.isEmpty, "mapping: the picker's setter refuses the dedupe key, the owner and another field's property")
    expect(!rs.canTarget(.calls, "hs_call_title", "hs_call_external_id") && !rs.canTarget(.deals, "closedate", "hubspot_owner_id") && !rs.canTarget(.deals, "hs_next_step", "dealstage")
           && !rs.canTarget(.tasks, "hs_task_subject", "hs_task_status") && rs.canTarget(.calls, "hs_call_title", "pn_call_title") && rs.canTarget(.calls, "hs_call_title", ""),
           "mapping: reserved targets are not offered")
    // the same from a settings file edited by hand: the write path ignores the bad mapping
    rs.fields = ["calls": ["hs_call_title": "hs_call_external_id"], "deals": ["hs_next_step": "hubspot_owner_id"]]
    let rm = rs.mapped(.calls, ["hs_call_title": "Orbit renewal", "hs_call_external_id": "pacenote:k1"])
    expect(rm["hs_call_external_id"] as? String == "pacenote:k1" && rm["hs_call_title"] as? String == "Orbit renewal", "mapping: a stored mapping onto the dedupe key keeps the key")
    let rh = HubSpotConnector(transport: bf, sleep: { _ in }); rh.sync = rs
    _ = try? await rh.updateDeal(id: "D1", fields: ["hs_next_step": "Call back"])
    let dp = (bf.bodies.last?["properties"] as? [String: Any]) ?? [:]
    expect(dp["hubspot_owner_id"] == nil && dp["hs_next_step"] as? String == "Call back", "mapping: a deal field never writes the deal's owner")
    // collisions: two fields onto one property, or a field onto a property another input writes
    var cs = CRMSyncSettings(); cs.setProperty(.calls, "hs_call_title", to: "pn_x")
    expect(!cs.canTarget(.calls, "hs_call_body", "pn_x"), "mapping: a property one field writes is not offered to another")
    cs.fields["calls"]?["hs_call_body"] = "pn_x"
    let cm = cs.mapped(.calls, ["hs_call_title": "t", "hs_call_body": "b"])
    expect(cm["pn_x"] as? String == "t" && cm["hs_call_body"] as? String == "b" && cm.count == 2, "mapping: a second field onto the same property writes its default")
    var qs = CRMSyncSettings(); qs.setProperty(.deals, "hs_next_step", to: "budget_notes")
    let qm = qs.mapped(.deals, ["hs_next_step": "Call back", "budget_notes": "Approved"])
    expect(qm["budget_notes"] as? String == "Approved" && qm["hs_next_step"] as? String == "Call back", "mapping: a mapped field never overwrites another input's property")
    // Undo of a deal update restores exactly the properties written, whatever the mapping is now
    var later1 = CRMSyncSettings(); later1.setProperty(.deals, "hs_next_step", to: "pn_next"); hb.sync = later1
    try? await hb.restoreDeal(id: "D1", fields: ["hs_next_step": "Old"])
    expect(((bf.bodies.last?["properties"] as? [String: Any]) ?? [:]).mapValues { "\($0)" } == ["hs_next_step": "Old"], "undo: a remapped field is restored to the property written")
    hb.sync = ds      // hs_next_step set to Don't write since
    let sent = bf.bodies.count
    try? await hb.restoreDeal(id: "D1", fields: ["hs_next_step": "Old"])
    expect(bf.bodies.count == sent + 1 && ((bf.bodies.last?["properties"] as? [String: Any]) ?? [:]).mapValues { "\($0)" } == ["hs_next_step": "Old"],
           "undo: a field set to Don't write since is still restored")
    var emptyErr: Error? = nil
    do { try await hb.restoreDeal(id: "D1", fields: [:]) } catch { emptyErr = error }
    expect(emptyErr != nil && bf.bodies.count == sent + 1, "undo: nothing to restore is an error, never a silent success")
    // revisions: HubSpot's updatedAt from the answer to our write; a later change in HubSpot moves it
    let rt = FakeHubSpotCalls()
    let hv = HubSpotConnector(transport: rt, sleep: { _ in })
    let made = try? await hv.upsertCall(entry, knownId: "", associations: [])
    let mid = made?.id ?? ""
    let kept = hv.revision(type: "calls", id: mid)
    let nowRev = (try? await hv.updatedAt(type: "calls", id: mid)) ?? ""
    expect(!kept.isEmpty && kept == rt.updatedAt(mid) && CRMSyncLog.unchanged(revision: kept, current: nowRev), "undo: the write's revision is kept and matches while nobody changed the Call")
    rt.calls[mid]?["hs_call_title"] = "Edited in HubSpot"; rt.rev[mid, default: 0] += 1
    let edited = (try? await hv.updatedAt(type: "calls", id: mid)) ?? ""
    expect(!CRMSyncLog.unchanged(revision: kept, current: edited), "undo: an edit in HubSpot after the write stops the Undo")
    expect(hv.revision(type: "calls", id: "nope").isEmpty, "undo: no revision for an object Pacenote did not write")
    // PB-62 review: both Undo paths go through CRMCallSync.undo with guardUndo; nothing changes past the window, after
    // an edit in HubSpot, or in another portal
    let gt = FakeHubSpotCalls()
    let hg2 = HubSpotConnector(transport: gt, sleep: { _ in })
    let g1 = try? await hg2.upsertCall(entry, knownId: "", associations: [])
    let gid = g1?.id ?? "", grev = hg2.revision(type: "calls", id: gid)
    let gnow = Date()
    func guarded(_ deadline: Date, _ rev: String) -> (CRMUndoItem) async throws -> Void {
        { it in try await CRMSyncLog.guardUndo(type: it.type, id: it.id, revision: rev, deadline: deadline, connector: hg2) }
    }
    final class Outcomes { var codes: [Int] = [] }
    let oc = Outcomes()
    let gsent = gt.log.count
    let ex = try? await CRMCallSync.undo([CRMUndoItem("calls", gid)], portal: "500", connector: hg2, check: guarded(gnow.addingTimeInterval(-1), grev),
                                         result: { _, e in oc.codes.append((e as? CRMError)?.code ?? 0) })
    expect(ex == 1 && oc.codes == [CRMSyncLog.expiredCode] && gt.calls[gid] != nil && !gt.log.dropFirst(gsent).contains { $0.hasPrefix("DELETE") || $0.hasPrefix("PATCH") },
           "undo: past the window nothing is deleted")
    gt.rev[gid, default: 0] += 1      // someone edits the Call in HubSpot
    let ch = try? await CRMCallSync.undo([CRMUndoItem("calls", gid)], portal: "500", connector: hg2, check: guarded(gnow.addingTimeInterval(60), grev),
                                         result: { _, e in oc.codes.append((e as? CRMError)?.code ?? 0) })
    expect(ch == 1 && oc.codes.last == CRMSyncLog.changedCode && gt.calls[gid] != nil, "undo: an edit in HubSpot after the write stops the Undo")
    let nr = try? await CRMCallSync.undo([CRMUndoItem("calls", gid)], portal: "500", connector: hg2, check: guarded(gnow.addingTimeInterval(60), ""))
    expect(nr == 1 && gt.calls[gid] != nil, "undo: a write without a revision is never undone")
    gt.portal = 777
    var gerr: CRMError? = nil
    do { _ = try await CRMCallSync.undo([CRMUndoItem("calls", gid)], portal: "500", connector: hg2, check: guarded(gnow.addingTimeInterval(60), gt.updatedAt(gid))) }
    catch { gerr = error as? CRMError }
    expect(gerr?.code == CRMPortal.mismatchCode && gt.calls[gid] != nil, "undo: another portal changes nothing")
    gt.portal = 500
    let okU = try? await CRMCallSync.undo([CRMUndoItem("calls", gid)], portal: "500", connector: hg2, check: guarded(gnow.addingTimeInterval(60), gt.updatedAt(gid)))
    expect(okU == 0 && gt.calls[gid] == nil, "undo: inside the window, same portal, unchanged revision: the Call is deleted")
    // Undo of deal fields through the shared path restores the properties written (restoreDeal), not today's mapping
    let dfk = BodyFake()
    let hdk = HubSpotConnector(transport: dfk, sleep: { _ in })
    var remap = CRMSyncSettings(); remap.setProperty(.deals, "hs_next_step", to: "pn_next"); hdk.sync = remap
    _ = try? await CRMCallSync.undo([CRMUndoItem("deals", "D1", ["hs_next_step": "Old"])], portal: "1", connector: hdk)
    expect(((dfk.bodies.last?["properties"] as? [String: Any]) ?? [:]).mapValues { "\($0)" } == ["hs_next_step": "Old"], "undo: the shared Undo restores a deal's written properties")
    // a log that cannot be saved says so (the HubSpot write is reported separately)
    expect(!CRMSyncLog.save([CRMSyncEntry(object: "calls", action: "create", source: "click")], path: "/dev/null/pn-crm-log.json")
           && CRMSyncLog.save([], path: NSTemporaryDirectory() + "pn-crm-save-\(getpid()).json"), "log: a failed save is reported, not swallowed")
    // Auto's consent is asked when its turn comes: switched off while Apply wrote, Auto sends nothing
    final class Consent { var on = true; var id = "" }
    let ct = FakeHubSpotCalls(); ct.createDelay = 50_000_000
    var ctGo: AsyncStream<Void>.Continuation! = nil
    let ctOut = AsyncStream<Void> { ctGo = $0 }; ct.createStarted = { ctGo.yield() }
    let hc = HubSpotConnector(transport: ct, sleep: { _ in })
    let cq = CRMCallQueue(), consent = Consent()
    // a Call target of this check's call: `portal` (the link's), with the stored Call id and the associations
    func tg(_ portal: String, _ id: String = "", _ refs: [CRMRef] = []) -> CRMCallTarget {
        CRMCallTarget(callId: id, portalId: portal, callKey: entry.key, associations: refs) }
    async let applyW = try? CRMCallSync.log(entry, connector: hc, queue: cq, fallback: tg("500"),
                                            load: { tg("500", consent.id) }, save: { consent.id = $0; consent.on = false })
    for await _ in ctOut { break }      // Apply holds the turn: its create is out
    var autoErr: CRMError? = nil
    do { _ = try await CRMCallSync.log(entry, connector: hc, queue: cq, fallback: tg("500"), allowed: { consent.on },
                                       load: { tg("500", consent.id) }, save: { consent.id = $0 }) } catch { autoErr = error as? CRMError }
    let applied1 = await applyW
    expect(applied1?.created == true && ct.calls.count == 1 && autoErr?.code == CRMCallSync.notAllowedCode
           && ct.log.filter { $0 == "GET /account-info/v3/details" }.count == 1 && !ct.log.contains { $0.hasPrefix("PATCH") },
           "auto: turned off while waiting for its turn, Auto sends nothing: \(ct.log)")
    // PB-62 review round 2: a Call write failed in portal 500, then the key and the call's link moved to portal 600.
    // Retry is bound to the failed line's portal, so it sends nothing to 600 (only the account-info check goes out).
    // CRMCallLogger.write pins the fallback and the link read at the turn the same way (CRMSyncLog.retryTarget)
    let c7 = [CRMRef("companies", "C7")]
    func retry(_ bound: String, _ t: CRMCallTarget) -> CRMCallTarget { CRMSyncLog.retryTarget(bound: bound, t) }
    let moved = FakeHubSpotCalls(); moved.portal = 600
    let hm = HubSpotConnector(transport: moved, sleep: { _ in })
    var retryErr: CRMError? = nil
    do { _ = try await CRMCallSync.log(entry, connector: hm, queue: CRMCallQueue(), fallback: retry("500", tg("600", "", c7)),
                                       load: { retry("500", tg("600", "", c7)) }, save: { _ in }) } catch { retryErr = error as? CRMError }
    expect(retryErr?.code == CRMPortal.mismatchCode && moved.calls.isEmpty && moved.log == ["GET /account-info/v3/details"],
           "retry: a failure in another portal is never sent to the portal the key and link moved to: \(moved.log)")
    // a key changed back while the link still names the new portal: still refused, and an old line without a portal too
    expect(CRMSyncLog.retryPortal(bound: "500", link: "600") == "" && CRMSyncLog.retryPortal(bound: "", link: "600") == ""
           && CRMSyncLog.retryPortal(bound: "600", link: "600") == "600", "retry: only the failed line's portal, and only while the link names it")
    let same = FakeHubSpotCalls(); same.portal = 600
    expect(CRMSyncLog.retryTarget(bound: nil, tg("600")) == tg("600") && CRMSyncLog.retryTarget(bound: "500", tg("600", "9", c7)) == tg("", "9", c7),
           "retry: only a Retry pins the portal, and keeps the stored id and associations")
    let r600 = try? await CRMCallSync.log(entry, connector: HubSpotConnector(transport: same, sleep: { _ in }), queue: CRMCallQueue(),
                                          fallback: retry("600", tg("600")), load: { retry("600", tg("600")) }, save: { _ in })
    expect(r600?.created == true && same.calls.count == 1, "retry: the failed line's own portal is written")
    // a Retry of a portal 500 line whose link was relinked to 600 after the Retry started: nothing is sent
    let late = FakeHubSpotCalls(); late.portal = 600
    var lateErr: CRMError? = nil
    do { _ = try await CRMCallSync.log(entry, connector: HubSpotConnector(transport: late, sleep: { _ in }), queue: CRMCallQueue(),
                                       fallback: retry("500", tg("500")), load: { retry("500", tg("600", "", c7)) }, save: { _ in }) } catch { lateErr = error as? CRMError }
    expect(lateErr?.code == CRMPortal.mismatchCode && late.log.isEmpty, "retry: relinked before its turn, a Retry sends nothing: \(late.log)")
    let failedLine = CRMSyncEntry(object: "calls", action: "create", source: "auto", ok: false, error: "HTTP 500", portal: "500")
    let failedJSON = (try? JSONEncoder().encode([failedLine])).flatMap { try? JSONDecoder().decode([CRMSyncEntry].self, from: $0) }
    expect(failedJSON?.first?.portal == "500", "retry: a failed line keeps the portal it was meant for")
    // PB-62 review round 3: the Call write to portal 500 is out when the PM reconnects and relinks to 600, then it fails.
    // The line keeps the portal the turn was checked against (500), not the link read after the request, so its Retry
    // sends nothing to 600
    final class LinkBox: @unchecked Sendable { var portal = "500" }
    let inflight = FakeHubSpotCalls(); inflight.createDelay = 50_000_000; inflight.failCreate = true
    var inGo: AsyncStream<Void>.Continuation! = nil
    let inOut = AsyncStream<Void> { inGo = $0 }; inflight.createStarted = { inGo.yield() }
    let box = LinkBox(), attempt = CRMSyncLog.Attempt()
    async let outW: Error? = { do { _ = try await CRMCallSync.log(entry, connector: HubSpotConnector(transport: inflight, sleep: { _ in }), queue: CRMCallQueue(),
                                                              fallback: tg("500", "", c7), checked: attempt.record,
                                                              load: { tg(box.portal, "", c7) }, save: { _ in }); return nil } catch { return error } }()
    for await _ in inOut { break }      // the portal was checked and the create is out
    box.portal = "600"; inflight.lock.withLock { inflight.portal = 600 }     // reconnected and relinked while the create waits
    let outErr = await outW
    expect(outErr != nil && attempt.portal == "500" && box.portal == "600", "retry: a failure keeps the portal it was sent to, not the one relinked to meanwhile")
    let relinked = FakeHubSpotCalls(); relinked.portal = 600
    var relinkErr: CRMError? = nil
    do { _ = try await CRMCallSync.log(entry, connector: HubSpotConnector(transport: relinked, sleep: { _ in }), queue: CRMCallQueue(),
                                       fallback: retry(attempt.portal, tg(box.portal, "", c7)),
                                       load: { retry(attempt.portal, tg(box.portal, "", c7)) }, save: { _ in }) } catch { relinkErr = error as? CRMError }
    expect(relinkErr?.code == CRMPortal.mismatchCode && relinked.calls.isEmpty && relinked.log == ["GET /account-info/v3/details"],
           "retry: a failure from before a relink sends nothing to the new portal: \(relinked.log)")
    // PB-62 review round 6: the Call write to portal 500 is out when the PM relinks the call to 600, then it succeeds.
    // 500's new Call id is not stored on the 600 link (the next sync would trust it there and overwrite another Call),
    // and the sync line still names 500
    final class IdBox: @unchecked Sendable { var portal = "500", callId = "" }
    func relinkWhileOut(_ relink: Bool) async -> (CRMCallResult?, IdBox, CRMSyncLog.Attempt) {
        let ok = FakeHubSpotCalls(); ok.createDelay = 50_000_000
        var go: AsyncStream<Void>.Continuation! = nil
        let out = AsyncStream<Void> { go = $0 }; ok.createStarted = { go.yield() }
        let b = IdBox(), at = CRMSyncLog.Attempt()
        async let w = try? CRMCallSync.log(entry, connector: HubSpotConnector(transport: ok, sleep: { _ in }), queue: CRMCallQueue(),
                                           fallback: tg("500"), checked: at.record, load: { tg(b.portal, b.callId) }, save: { b.callId = $0 })
        for await _ in out { break }      // the portal was checked and the create is out
        if relink { b.portal = "600"; b.callId = "" }
        return (await w, b, at)
    }
    let (okR, okBox, okAt) = await relinkWhileOut(true)
    expect(okR?.created == true && okBox.callId == "" && okBox.portal == "600" && okAt.portal == "500",
           "relink: a Call id written to the old portal is not stored on the relinked call: \(okBox.callId) \(okAt.portal)")
    let (keptR, keptBox, _) = await relinkWhileOut(false)
    expect(keptR?.created == true && !keptBox.callId.isEmpty && keptBox.callId == keptR?.id, "relink: without a relink the new Call id is stored")
    // the turn never came (Auto switched off while waiting): no portal, so no Retry target
    let never = CRMSyncLog.Attempt()
    _ = try? await CRMCallSync.log(entry, connector: HubSpotConnector(transport: FakeHubSpotCalls(), sleep: { _ in }), queue: CRMCallQueue(),
                                   fallback: tg("500"), allowed: { false }, checked: never.record, load: { tg("500") }, save: { _ in })
    expect(never.portal == "", "retry: a write that never had its turn names no portal")
    // PB-62 review round 7: Auto made its entry from the portal 500 link, the call was relinked to 600 before its turn:
    // nothing is sent, and the line names no portal, so it has no Retry target either
    let gone = CRMSyncLog.Attempt(), gf = FakeHubSpotCalls(); gf.portal = 600
    var goneErr: CRMError? = nil
    do { _ = try await CRMCallSync.log(entry, connector: HubSpotConnector(transport: gf, sleep: { _ in }), queue: CRMCallQueue(),
                                       fallback: tg("500", "", c7), checked: gone.record, load: { tg("600", "", [CRMRef("companies", "C600")]) },
                                       save: { _ in }) } catch { goneErr = error as? CRMError }
    expect(goneErr?.code == CRMPortal.mismatchCode && gf.log.isEmpty && gone.portal == "",
           "auto: an entry made for portal 500 is never sent to the portal the call was relinked to: \(gf.log)")
    // owners: the mapping, then the user of this Mac gets the Matching owner, then the same email, else HubSpot's default
    var o = CRMSettings(); o.ownerId = "7"
    let hsOwners = [CRMOwner(id: "11", name: "Emily Clark", email: "emily.clark@example.com"), CRMOwner(id: "12", name: "James Miller", email: "james.miller@example.com")]
    o.sync.owners["james.miller@example.com"] = "11"
    expect(o.ownerId(forPacenoteUser: "James.Miller@example.com ", ownEmails: [], owners: hsOwners) == "11", "owners: the mapping comes first")
    expect(o.ownerId(forPacenoteUser: "me@example.com", ownEmails: ["ME@example.com"], owners: hsOwners) == "7" && o.ownerId(forPacenoteUser: "", ownEmails: [], owners: hsOwners) == "7", "owners: the user of this Mac gets the Matching owner")
    expect(o.ownerId(forPacenoteUser: "emily.clark@example.com", ownEmails: [], owners: hsOwners) == "11", "owners: else the HubSpot owner with the same email")
    expect(o.ownerId(forPacenoteUser: "sarah.davis@example.com", ownEmails: [], owners: hsOwners) == "", "owners: else nothing, HubSpot's default")
    // the sync log of one Apply: written objects, then one failed line for the object whose request failed
    let plan = CRMUpdatePlan.build(title: "Orbit renewal", date: "", summary: ["Budget approved"], decisions: [], nextSteps: [], notionURL: "", transcript: nil,
                                   nextStep: "Call back", closeDate: "", stage: nil, qualification: [:], mapping: [:], followUp: ("Call back", nil), callLog: entry)
    let now = Date(timeIntervalSince1970: 1_780_100_000)
    let lines = CRMSyncLog.applyEntries(plan: plan, done: [CRMUndoItem("notes", "N1"), CRMUndoItem("calls", "C1")], error: "HubSpot is busy (429); try again in a minute.",
                                        failed: "deals", portal: "500", source: "click", sync: CRMSyncSettings(), revisions: ["calls/C1": "2026-05-30T00:50:00.123Z"], now: now)
    expect(lines[1].revision == "2026-05-30T00:50:00.123Z" && lines[0].revision.isEmpty, "log: each line keeps HubSpot's revision of its own write")
    expect(lines.map(\.object) == ["notes", "calls", "deals"] && lines.map(\.ok) == [true, true, false] && lines[1].action == "create" && lines[2].error.contains("429"),
           "log: written objects, then the failed one")
    expect(lines.allSatisfy { $0.portal == "500" }, "log: every line keeps the portal it was written to")
    expect(lines[1].fields.contains("hs_call_title") && lines[1].fields.contains("hs_call_body") && lines[0].fields == ["hs_note_body"], "log: property names of what was written")
    let json = String(decoding: (try? JSONEncoder().encode(lines)) ?? Data(), as: UTF8.self)
    expect(!json.contains("Budget approved") && !json.contains("Orbit renewal"), "log: a create keeps property names, not the texts written")
    let other = CRMSyncLog.applyEntries(plan: plan, done: [CRMUndoItem("contacts", "P1", ["jobtitle": "CTO"]), CRMUndoItem("meetings", "M1")], error: nil, failed: nil,
                                        portal: "500", source: "click", sync: CRMSyncSettings(), now: now)
    expect(other[0].action == "update" && other[0].fields == ["jobtitle"] && other[1].action == "create" && other[1].fields.isEmpty,
           "log: another branch's update with old values is an update (Undo restores, never deletes)")
    let noneOut = CRMSyncLog.applyEntries(plan: plan, done: [CRMUndoItem("notes", "N1")], error: "HTTP 500", failed: "", portal: "500", source: "click", sync: CRMSyncSettings(), now: now)
    expect(noneOut.count == 1 && noneOut[0].ok, "log: an error while no request of this Apply was out blames no row")
    // PB-62 review: the deal is ticked but all its fields are Don't write, then the task request fails. Apply skips the
    // deal (no request), the failed line is the task, and Retry reopens the task row, not the deal
    let at = ApplyFake(); at.failTask = true
    let ha = HubSpotConnector(transport: at, sleep: { _ in })
    var dw = CRMSyncSettings(); dw.setProperty(.deals, "hs_next_step", to: ""); dw.setProperty(.deals, "closedate", to: ""); ha.sync = dw
    var ap = CRMUpdatePlan.build(title: "Orbit renewal", date: "", summary: ["a"], decisions: [], nextSteps: [], notionURL: "", transcript: nil,
                                 nextStep: "Call back", closeDate: "", stage: nil, qualification: [:], mapping: [:], followUp: ("Call back", nil),
                                 writeNote: true, writeDeal: true, writeTask: true)
    ap.dealFields = ["hs_next_step": "Call back"]
    let ao = await CRMApply.run(plan: ap, dealId: "D1", refs: [CRMRef("deals", "D1")], connector: ha, sync: dw) { _ in CRMCallResult(id: "C9", created: true) }
    expect(ao.error != nil && ao.failed == "tasks" && ao.done.map(\.type) == ["notes"] && !at.log.contains { $0.contains("/deals/") },
           "apply: a deal with every field set to Don't write sends nothing and is not the failure: \(at.log)")
    let al = CRMSyncLog.applyEntries(plan: ap, done: ao.done, error: "HTTP 500", failed: ao.failed, portal: "500", source: "click", sync: dw, now: now)
    expect(al.map(\.object) == ["notes", "tasks"] && al.last?.ok == false && CRMSyncLog.canRetry(al.last!, in: al) && !al.contains { $0.object == "deals" },
           "apply: the failed task gets the Retry, the skipped deal gets no line")
    let at2 = ApplyFake(); at2.failNote = true
    let ao2 = await CRMApply.run(plan: ap, dealId: "D1", refs: [], connector: HubSpotConnector(transport: at2, sleep: { _ in }), sync: CRMSyncSettings()) { _ in CRMCallResult(id: "C9", created: true) }
    expect(ao2.failed == "notes" && ao2.done.isEmpty && !at2.log.contains { $0.contains("/tasks") }, "apply: the first failure stops the Apply and names its own row")
    // fix round 9: a Call relinked while Apply runs refuses after the note was written; the note keeps its line, the
    // refused Call gets none (Relink, not Retry)
    var apc = ap; apc.callLog = CRMCallLog(key: "k1", title: "Orbit", start: now, durationMs: 60_000, body: "b")
    for i in apc.rows.indices { apc.rows[i].on = ["note", "call"].contains(apc.rows[i].id) }
    if !apc.rows.contains(where: { $0.id == "call" }) { apc.rows.append(CRMUpdatePlan.Row(id: "call", title: "Call", detail: "", on: true)) }
    let ao3 = await CRMApply.run(plan: apc, dealId: "D1", refs: [], connector: HubSpotConnector(transport: ApplyFake(), sleep: { _ in }), sync: CRMSyncSettings()) { _ in
        throw CRMError(code: CRMPortal.mismatchCode, message: "relinked", scope: "portal")
    }
    let al3 = CRMSyncLog.applyEntries(plan: apc, done: ao3.done, error: nil, failed: nil, portal: "500", source: "click", sync: CRMSyncSettings(), now: now)
    expect(ao3.failed == "calls" && ao3.done.map(\.type) == ["notes"] && al3.map(\.object) == ["notes"] && al3.allSatisfy(\.ok),
           "apply: a note written before a relinked Call keeps its log line")
    // Retry and Undo
    expect(CRMSyncLog.canRetry(lines[2], in: lines) && !CRMSyncLog.canRetry(lines[0], in: lines), "log: a failed write can be retried")
    var later = CRMSyncEntry(at: now.addingTimeInterval(60), object: "deals", action: "update", source: "retry", hubspotId: "D1", fields: ["hs_next_step"], old: ["hs_next_step": "Old"], revision: "r")
    expect(!CRMSyncLog.canRetry(lines[2], in: lines + [later]), "log: no Retry after a later good write")
    expect(CRMSyncLog.canUndo(lines[1], in: lines, now: now.addingTimeInterval(3600)), "log: Undo within the window")
    var noPortal = lines; noPortal[1].portal = ""
    expect(!CRMSyncLog.canUndo(noPortal[1], in: noPortal, now: now), "log: a line without its portal (written before this version) is never undone")
    expect(!CRMSyncLog.canUndo(lines[1], in: lines, now: now.addingTimeInterval(CRMSyncLog.logUndoSeconds + 1)), "log: no Undo after the window")
    let superseded = lines + [CRMSyncEntry(at: now.addingTimeInterval(30), object: "calls", action: "update", source: "auto", hubspotId: "C1", old: ["hs_call_title": "a"], revision: "r", portal: "500")]
    expect(!CRMSyncLog.canUndo(lines[1], in: superseded, now: now) && CRMSyncLog.canUndo(superseded.last!, in: superseded, now: now), "log: only the latest write of an object can be undone")
    expect(!CRMSyncLog.canUndo(lines[0], in: lines, now: now), "log: a write without HubSpot's revision is never undone from the log")
    later.old = [:]
    expect(!CRMSyncLog.canUndo(later, in: [later], now: now), "log: an update without old values cannot be undone")
    let undone = CRMSyncLog.withUndo(lines, object: "calls", hubspotId: "C1", error: nil, source: "log", now: now)
    expect(undone[1].undone && undone.last?.action == "undo" && !CRMSyncLog.canUndo(undone[1], in: undone, now: now), "log: Undo marks the write and is not offered twice")
    let failedUndo = CRMSyncLog.withUndo(lines, object: "calls", hubspotId: "C1", error: "HTTP 500", source: "log", now: now)
    expect(!failedUndo[1].undone && failedUndo.last?.ok == false, "log: a failed Undo keeps the write")
    // Undo needs HubSpot's revision unchanged since the write: a change a second later, a missing or unreadable one stops it
    expect(CRMSyncLog.unchanged(revision: "2026-05-30T00:50:00.123Z", current: "2026-05-30T00:50:00.123Z")
           && CRMSyncLog.unchanged(revision: "2026-05-30T00:50:00Z", current: "2026-05-30T00:50:00.000Z")
           && !CRMSyncLog.unchanged(revision: "2026-05-30T00:50:00.123Z", current: "2026-05-30T00:50:01.123Z")
           && !CRMSyncLog.unchanged(revision: "2026-05-30T00:50:00.123Z", current: "")
           && !CRMSyncLog.unchanged(revision: "", current: "2026-05-30T00:50:00.123Z")
           && !CRMSyncLog.unchanged(revision: "2026-05-30T00:50:00.123Z", current: "yesterday"), "log: Undo only while HubSpot's revision is the one of the write")
    // the file next to the call: append, load, cap
    let dir = NSTemporaryDirectory() + "pn-crm-log-\(getpid())"
    let stem = dir + "/2026-11-22-1400-orbit"
    CRMSyncLog.append(lines, stem: stem)
    CRMSyncLog.recordUndo(object: "calls", hubspotId: "C1", error: nil, source: "click", stem: stem)
    let loaded = CRMSyncLog.load(path: CRMSyncLog.path(stem: stem))
    expect(loaded.count == 4 && loaded[1].undone && loaded[0].at == now, "log: saved next to the call and read back")
    // the click rechecks the log on disk: a button drawn earlier does not undo an expired or replaced write
    let stem2 = dir + "/2026-11-22-1500-orbit"
    let w = CRMSyncEntry(at: now, object: "deals", action: "update", source: "click", hubspotId: "D1", fields: ["hs_next_step"], old: ["hs_next_step": "Old"], revision: "r1", portal: "500")
    CRMSyncLog.append([w], stem: stem2)
    expect(CRMSyncLog.undoable(id: w.id, stem: stem2, now: now.addingTimeInterval(60))?.id == w.id, "log: Undo on the click within the window")
    expect(CRMSyncLog.undoable(id: w.id, stem: stem2, now: now.addingTimeInterval(CRMSyncLog.logUndoSeconds + 1)) == nil, "log: no Undo on a click after the window")
    CRMSyncLog.append([CRMSyncEntry(at: now.addingTimeInterval(10), object: "deals", action: "update", source: "click", hubspotId: "D1", old: ["hs_next_step": "x"], revision: "r2")], stem: stem2)
    expect(CRMSyncLog.undoable(id: w.id, stem: stem2, now: now.addingTimeInterval(60)) == nil, "log: no Undo on a click after a later write of the object")
    CRMSyncLog.append((0..<250).map { CRMSyncEntry(object: "calls", action: "create", source: "auto", hubspotId: "\($0)") }, stem: stem)
    expect(CRMSyncLog.load(path: CRMSyncLog.path(stem: stem)).count == CRMSyncLog.maxEntries, "log: capped")
    // fix round 9: a log file that is there but cannot be decoded (a good line and an element that is not a line) or
    // read (a folder in its place) is never replaced by the new lines alone; append and Undo say they did not save
    let stem3 = dir + "/2026-11-22-1600-orbit"
    let bad = Data("[{\"id\":\"keep-1\",\"object\":\"calls\",\"action\":\"create\",\"source\":\"auto\",\"hubspotId\":\"C7\",\"ok\":true}, 42]".utf8)
    try? FileManager.default.createDirectory(atPath: (CRMSyncLog.path(stem: stem3) as NSString).deletingLastPathComponent, withIntermediateDirectories: true)
    FileManager.default.createFile(atPath: CRMSyncLog.path(stem: stem3), contents: bad)
    let badAppend = CRMSyncLog.append([CRMSyncEntry(object: "notes", action: "create", source: "click", hubspotId: "N1")], stem: stem3)
    let badUndo = CRMSyncLog.recordUndo(object: "calls", hubspotId: "C7", error: nil, source: "log", stem: stem3)
    expect(!badAppend && !badUndo && FileManager.default.contents(atPath: CRMSyncLog.path(stem: stem3)) == bad && CRMSyncLog.unreadable(stem: stem3),
           "log: an unreadable log keeps its bytes, append and Undo report not saved")
    let stem4 = dir + "/2026-11-22-1700-orbit"
    try? FileManager.default.createDirectory(atPath: CRMSyncLog.path(stem: stem4), withIntermediateDirectories: true)
    expect(!CRMSyncLog.append([CRMSyncEntry(object: "notes", action: "create", source: "click")], stem: stem4) && CRMSyncLog.unreadable(stem: stem4),
           "log: a log path that cannot be read is not written over")
    let stem5 = dir + "/2026-11-22-1800-orbit"
    expect(!CRMSyncLog.unreadable(stem: stem5) && CRMSyncLog.append([CRMSyncEntry(object: "notes", action: "create", source: "click")], stem: stem5)
           && CRMSyncLog.load(path: CRMSyncLog.path(stem: stem5)).count == 1, "log: no file yet is an empty log, the first line is saved")
    try? FileManager.default.removeItem(atPath: dir)
    // the live check: a 403 on a probe marks its scope; a server error does not
    let sf = StatusFake()
    sf.status = ["/crm/v3/owners": 403, "/crm/v3/properties/deals": 403, "/crm/v3/objects/companies": 500]
    let missing = await CRMScopeCheck.missing(HubSpotConnector(transport: sf, sleep: { _ in }))
    expect(missing == ["crm.objects.owners.read", "crm.schemas.deals.read"], "scopes: 403 probes are missing, 500 is not: \(missing)")
    let full = await CRMScopeCheck.check(HubSpotConnector(transport: sf, sleep: { _ in }))
    expect(full.missing == missing && full.unverified == ["crm.objects.companies.read"], "scopes: a probe that failed another way is reported as not verified: \(full.unverified)")
    expect(CRMScopeCheck.blocking(.deals, missing: ["crm.objects.deals.write"]) == ["crm.objects.deals.write"] && CRMScopeCheck.blocking(.deals, missing: missing).isEmpty,
           "scopes: a switch shows the scope it needs")
    // what the live check finds must be able to reach a switch: every probed scope blocks some object, and a refused owners read blocks Calls
    expect(CRMScopeCheck.probes.filter { !$0.scope.contains(".schemas.") }.allSatisfy { p in CRMObject.allCases.contains { $0.scopes.contains(p.scope) } }
           && CRMScopeCheck.blocking(.calls, missing: missing) == ["crm.objects.owners.read"],
           "scopes: a scope the live check finds missing shows on the switch that needs it")
}

